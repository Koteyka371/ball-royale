    elif typeof(world) == TYPE_OBJECT and "permanent_aura_buffs" in world and typeof(world.permanent_aura_buffs) == TYPE_DICTIONARY and world.permanent_aura_buffs.has(team):
        var stacks = world.permanent_aura_buffs[team]
