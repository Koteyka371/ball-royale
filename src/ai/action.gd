    elif "aura_amplifier_timer" in self.ball:
        amp_timer = float(self.ball.aura_amplifier_timer)

    if amp_timer > 0.0:
        aura_radius *= 2.0
        aura_multiplier *= 2.0
        amp_timer -= delta
        if amp_timer < 0.0: amp_timer = 0.0
        if typeof(self.ball) != TYPE_DICTIONARY and self.ball.has_method("set_meta"):
