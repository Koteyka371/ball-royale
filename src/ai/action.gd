        ab_timer = float(self.ball.get_meta("aura_booster_timer"))
    elif "aura_booster_timer" in self.ball:
        ab_timer = float(self.ball.aura_booster_timer)
    if ab_timer > 0.0:
        aura_radius = 500.0
        aura_multiplier = 2.0

