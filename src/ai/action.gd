                elif typeof(self.ball) == TYPE_OBJECT and self.ball.has_method("has_meta") and self.ball.has_meta("id"): my_id = self.ball.get_meta("id")

                if is_turret and b_owner_id != null and my_id != null and b_owner_id == my_id:
