                    if a_id != o_id:
                        allies.append(a)

                if allies.size() > 0:
                    var min_dist = INF
                    var nearest_ally = null
                    for a in allies:
                        var dx_a = 0.0
                        var dy_a = 0.0
                        if typeof(a) == TYPE_DICTIONARY:
                            dx_a = a["x"] - b_x
                            dy_a = a["y"] - b_y
                        else:
                            dx_a = a.x - b_x
                            dy_a = a.y - b_y
                        var dist_sq = dx_a * dx_a + dy_a * dy_a
                        if dist_sq < min_dist:
                            min_dist = dist_sq
                            nearest_ally = a

                    if nearest_ally != null:
                        knockback_multiplier *= 0.5

