						var pull_radius = 500.0

						if dist_sq < pull_radius * pull_radius and dist_sq > 0.0001:
							var dist = sqrt(dist_sq)
							var nx = dx / dist
							var ny = dy / dist
							var pull_strength = (1.0 - (dist / pull_radius)) * 400.0 * delta

							bx += nx * pull_strength
							by += ny * pull_strength

							if typeof(b) == TYPE_DICTIONARY:
