			"vy": b.vy if "vy" in b else 0.0
		}
		for eff in status_effects:
			if eff in b:
				state[eff] = b[eff]
			elif typeof(b) == TYPE_OBJECT and b.has_method("has_meta") and b.has_meta(eff):
				state[eff] = b.get_meta(eff)
