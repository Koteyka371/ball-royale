				vt.set_meta("start_y", 0.0)
				vt.set_meta("end_x", x_pos)
				vt.set_meta("end_y", ah)
				vt.set_meta("warning_timer", 1.5)
				vt.set_meta("active_timer", 0.5)
				vt.duration = 9999.0
				world.arena.hazards.append(vt)

