			if "sponsor" in b:
				sponsor = b.sponsor
			elif b.has_method("get_meta") and b.has_meta("sponsor"):
				sponsor = b.get_meta("sponsor")

			if sponsor == "aggressor":
				if "max_hp" in b:
					b.max_hp *= 0.8
					if "hp" in b: b.hp = min(b.hp, b.max_hp)
			elif sponsor == "juggernaut":
