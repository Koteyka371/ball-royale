		min_y = 0.0
		max_y = arena_height

	func tick(world, balls: Array, delta: float = 0.016) -> void:
		if max_x - min_x > 50.0:
			min_x += shrink_rate * delta
			max_x -= shrink_rate * delta

		if max_y - min_y > 50.0:
			min_y += shrink_rate * delta
			max_y -= shrink_rate * delta

		var arena_width: float = 1000.0
		var arena_height: float = 1000.0
