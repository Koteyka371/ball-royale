				arena_width = world["arena"].get("width") if "width" in world["arena"] else 1000.0
				arena_height = world["arena"].get("height") if "height" in world["arena"] else 1000.0
		elif typeof(world) == TYPE_OBJECT and world.get("arena") != null:
