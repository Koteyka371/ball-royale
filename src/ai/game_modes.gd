											if b.get("hp") <= 0:
												b.set("alive", false)
				if payload_red.x < 50.0:
					payload_red.x = 50.0

		if payload_blue != null and payload_blue.alive:
			var pushers = 0
			for b in balls:
				if typeof(b) == TYPE_DICTIONARY:
