							h["x"] -= hvx * delta * 0.5
							h["y"] -= hvy * delta * 0.5

							var keys = h.keys()
							for k in keys:
								if typeof(k) == TYPE_STRING and (k.ends_with("_timer") or k.ends_with("_duration") or k.ends_with("_cooldown") or k == "duration" or k == "lifetime"):
									var val = h[k]
									if typeof(val) == TYPE_INT or typeof(val) == TYPE_FLOAT:
