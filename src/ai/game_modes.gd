				var wt = 0.0
				if typeof(h) == TYPE_DICTIONARY:
					wt = h.get("warning_timer", 0.0)
				elif typeof(h) == TYPE_OBJECT:
					if h.has_meta("warning_timer"): wt = h.get_meta("warning_timer")
					elif "warning_timer" in h: wt = h.warning_timer

				if wt > 0:
					wt -= delta
					if typeof(h) == TYPE_DICTIONARY:
						h["warning_timer"] = wt
						if wt <= 0:
