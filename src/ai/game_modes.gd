						elif h.has_method("set_meta"): h.set_meta("duration", dur)

						if dur <= 0:
							hazards_to_remove.append(h)
				elif h_kind == "ticking_bomb" and h_active:
					if typeof(h) == TYPE_DICTIONARY and h.has("duration"):
						h.duration -= delta
						if h.duration <= 0:
							h.active = false
							hazards_to_remove.append(h)

							var explosion_radius = 250.0
