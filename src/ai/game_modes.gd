class PulsatingCoreMode extends GameMode:
	var spawn_timer: float = 15.0

	func _init() -> void:
		super()
		name = "Pulsating Core"

	func tick(world, balls: Array, delta: float = 0.016) -> void:
		spawn_timer -= delta
		if spawn_timer <= 0:
			spawn_timer = 20.0
			if world != null and typeof(world) == TYPE_OBJECT and "arena" in world and world.arena != null:
